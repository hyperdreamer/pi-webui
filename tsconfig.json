{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noEmit": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@hyperdreamer/pi-webui/plugin-api": ["./src/plugin-api.ts"],
      "@hyperdreamer/pi-webui/plugin-api/unstable": ["./src/plugin-api/unstable.ts"],
      "@pi-webui/workspace-tasks-domain": ["./src/shared/workspaceTasks.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "extensions/**/*.ts",
    "pi-webui-plugins/**/*.ts"
  ]
}
