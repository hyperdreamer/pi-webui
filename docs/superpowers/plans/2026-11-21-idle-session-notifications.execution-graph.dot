digraph pm_execution {
  rankdir=LR;
  node [shape=box, style=rounded, fontsize=10];
  subgraph cluster_browser_core {
    label="browser-core";
    T-001 [label="Task 1: Define browser preference and completion candidates\n"];
    T-003 [label="Task 3: Persist atomic completion claims\n"];
    T-004 [label="Task 4: Coordinate current viewers across tabs\n"];
    T-005 [label="Task 5: Orchestrate browser alerts and payloads\n"];
