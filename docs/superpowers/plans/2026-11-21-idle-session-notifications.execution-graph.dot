    T-006 [label="Task 6: Resolve a clicked alert target\n"];
  }
  subgraph cluster_app_integration {
    label="app-integration";
    T-007 [label="Task 7: Wire socket lifecycle and verified alert activation\n"];
    T-008 [label="Task 8: Expose notification settings and complete browser acceptance\n"];
  }
  T-001 -> T-003;
  T-001 -> T-004;
  T-003 -> T-004;
  T-001 -> T-005;
  T-002 -> T-005;
  T-003 -> T-005;
  T-004 -> T-005;
  T-001 -> T-006;
  T-005 -> T-007;
  T-006 -> T-007;
  T-007 -> T-008;
}
